{
  "name": "coder-tools",
  "description": "程序员常用工具箱（Chrome 扩展）",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check . && tsc --noEmit",
    "check:fix": "biome check --write .",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cronstrue": "^3.3.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.16",
    "json5": "^2.2.3",
    "jszip": "^3.10.2",
    "lucide-react": "^0.544.0",
    "marked": "^18.0.14",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "smol-toml": "^1.9.0",
    "tailwind-merge": "^3.3.1",
    "uuid": "^13.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcryptjs": "^3.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "ngeohash": "^0.6.4",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "wxt": "^0.21.3"
  }
}
